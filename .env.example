PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8787
DATA_DIR=./data
# Production requires HTTPS. Use a reverse proxy with TLS.
COOKIE_SECURE=false
# Resend API key and verified sender. Never put the key in browser code.
RESEND_API_KEY=
EMAIL_FROM=
# At least 32 random characters. Used to hash email codes.
AUTH_SECRET=
# Optional restricted email list for initial personal use, separated by commas.
ALLOWED_EMAILS=
# Web Push requires installation of web-push and a VAPID key pair; see README.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
